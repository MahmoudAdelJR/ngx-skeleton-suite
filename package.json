{
  "name": "ngx-skeleton-suite-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "verify:decoupling": "node scripts/verify-decoupling.mjs",
    "dev:docs": "npm --prefix docs run dev",
    "build:docs": "npm --prefix docs run build",
    "preview:docs": "npx http-server docs/dist -p 4321"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cdk": "^20.2.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/starlight": "^0.41.4",
    "@types/jasmine": "~5.1.0",
    "astro": "^7.1.3",
    "cookie": "^2.0.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.2.0",
    "ngx-skeleton-loader": "^13.0.0",
    "primeng": "^20.4.0",
    "typescript": "~5.9.2"
  }
}
